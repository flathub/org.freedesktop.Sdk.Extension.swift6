{
    "id": "org.freedesktop.Sdk.Extension.swift6",
    "branch": "25.08",
    "runtime": "org.freedesktop.Sdk",
    "build-extension": true,
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.llvm18"
    ],
    "runtime-version": "25.08",
    "separate-locales": false,
    "build-options": {
        "prefix": "/usr/lib/sdk/swift6",
        "prepend-pkg-config-path": "/usr/lib/sdk/swift6/lib/pkgconfig/"
    },
    "cleanup": [
        "/share/info",
        "/share/man"
    ],
    "modules": [
        {
            "name": "swift",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://download.swift.org/swift-6.2-release/amazonlinux2/swift-6.2-RELEASE/swift-6.2-RELEASE-amazonlinux2.tar.gz",
                    "sha256": "132a3c533cc92d49b14dc0c2f65b4b1056af5fc45a37e0c6828e7ec7b9488753"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://download.swift.org/swift-6.2-release/amazonlinux2-aarch64/swift-6.2-RELEASE/swift-6.2-RELEASE-amazonlinux2-aarch64.tar.gz",
                    "sha256": "dbd63ae19f3404cf9007ff650798e00b7fa47f128dafca2454461b4143ac6d98"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
                }
            ],
            "build-commands": [
                "mkdir -p /usr/lib/sdk/swift6",
                "cp -R usr/* /usr/lib/sdk/swift6",
                "install -Dm644 org.freedesktop.Sdk.Extension.swift6.metainfo.xml $FLATPAK_DEST/share/metainfo/org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
            ]
        },
        {
            "name": "SwiftLint",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/realm/SwiftLint/archive/refs/tags/0.61.0.zip",
                    "sha256": "cfb9ad57bfc699dfa4ef7e301c5ac84817fe64f257676d5775d147b5332bd73f"
                },
                "generated-sources-swiftlint.json"
            ],
            "build-commands": [
            	"./setup-offline-swiftlint.sh",
            	"/usr/lib/sdk/swift6/bin/swift build -c release --skip-update",
            	"strip -s .build/release/swiftlint",
                "cp .build/release/swiftlint /usr/lib/sdk/swift6/bin/"
            ]
        },
        {
            "name": "swift-format",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/swiftlang/swift-format.git",
                    "commit": "62eaad2822b865407b8cde56c36386c00800f7ec"
                },
                "generated-sources.json"
            ],
            "build-commands": [
                "./setup-offline.sh",
                "/usr/lib/sdk/swift6/bin/swift build -c release --skip-update",
                "strip -s .build/release/swift-format",
                "cp .build/release/swift-format /usr/lib/sdk/swift6/bin/"
            ]
        }
    ]
}
