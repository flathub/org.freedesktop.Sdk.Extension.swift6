{
    "id": "org.freedesktop.Sdk.Extension.swift6",
    "branch": "25.08",
    "runtime": "org.freedesktop.Sdk",
    "build-extension": true,
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.llvm21"
    ],
    "runtime-version": "25.08",
    "separate-locales": false,
    "build-options": {
        "prefix": "/usr/lib/sdk/swift6",
        "prepend-pkg-config-path": "/usr/lib/sdk/swift6/lib/pkgconfig/",
        "prepend-ld-library-path": "/usr/lib/sdk/swift6/lib",
        "ldflags": "-L/usr/lib/sdk/swift6/lib"
    },
    "cleanup": [
        "/share/info",
        "/share/man"
    ],
    "modules": [
        {
            "name": "libxml2",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libxml2/2.13/libxml2-2.13.9.tar.xz",
                    "sha256": "a2c9ae7b770da34860050c309f903221c67830c86e4a7e760692b803df95143a"
                }
            ],
            "config-opts": [
                "--without-python",
                "--prefix=/usr/lib/sdk/swift6"
            ]
        },
        {
            "name": "swift",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://download.swift.org/swift-6.3.3-release/amazonlinux2/swift-6.3.3-RELEASE/swift-6.3.3-RELEASE-amazonlinux2.tar.gz",
                    "sha256": "ece8c60b48b52e589f144462e247617b6ea0ce9f85dbd3d12907cf1821e20c20"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://download.swift.org/swift-6.3.3-release/amazonlinux2-aarch64/swift-6.3.3-RELEASE/swift-6.3.3-RELEASE-amazonlinux2-aarch64.tar.gz",
                    "sha256": "ea7258ee30ccf21e8d20a007c41156be997ab558954c5ab12915c7a4fbcbc89e"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
                }
            ],
            "build-commands": [
                "cp -R usr/* /usr/lib/sdk/swift6",
                "install -Dm644 org.freedesktop.Sdk.Extension.swift6.metainfo.xml $FLATPAK_DEST/share/metainfo/org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
            ]
        },
        {
            "name": "SwiftLint",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://github.com/realm/SwiftLint/releases/download/0.65.0/swiftlint_linux_amd64.zip",
                    "sha256": "79306a34e5c7cc55a220cd108cbb861dcad5f10138dcdf261e2624ae8b0a486b"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://github.com/realm/SwiftLint/releases/download/0.65.0/swiftlint_linux_arm64.zip",
                    "sha256": "12d3b84bc5b69ae13a99a5a5c79904f9ce25867f099f6368d0037854f9ee6c26"
                }
            ],
            "build-commands": [
                "cp swiftlint /usr/lib/sdk/swift6/bin/"
            ]
        },
        {
            "name": "swift-format",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/swiftlang/swift-format/archive/refs/tags/603.0.0.zip",
                    "sha256": "8feae2b85a2ffd82a87f7f49457b4158686d59c35585c02394cf22678aa139f8"
                },
                "generated-sources.json"
            ],
            "build-commands": [
                "./setup-offline.sh",
                "/usr/lib/sdk/swift6/bin/swift build -c release --skip-update",
                "strip -s .build/release/swift-format",
                "cp .build/release/swift-format /usr/lib/sdk/swift6/bin/"
            ]
        }
    ]
}
