{
    "id": "org.freedesktop.Sdk.Extension.swift6",
    "branch": "24.08",
    "runtime": "org.freedesktop.Sdk",
    "build-extension": true,
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.llvm18"
    ],
    "runtime-version": "24.08",
    "separate-locales": false,
    "build-options": {
        "prefix": "/usr/lib/sdk/swift6",
        "prepend-pkg-config-path": "/usr/lib/sdk/swift6/lib/pkgconfig/"
    },
    "cleanup": [
        "/share/info",
        "/share/man"
    ],
    "modules": [
        {
            "name": "swift",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://download.swift.org/swift-6.1.2-release/amazonlinux2/swift-6.1.2-RELEASE/swift-6.1.2-RELEASE-amazonlinux2.tar.gz",
                    "sha256": "3f4b7e2c9219a52fcecb7cb90153f9aacd3da85aa53e75e38dd406c0e9122551"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://download.swift.org/swift-6.1.2-release/amazonlinux2-aarch64/swift-6.1.2-RELEASE/swift-6.1.2-RELEASE-amazonlinux2-aarch64.tar.gz",
                    "sha256": "9441091be33ca5d909337b8795f98e8234a52d79c197c6c015bca4b8994fbc87"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
                }
            ],
            "build-commands": [
                "mkdir -p /usr/lib/sdk/swift6",
                "cp -R usr/* /usr/lib/sdk/swift6",
                "install -Dm644 org.freedesktop.Sdk.Extension.swift6.metainfo.xml $FLATPAK_DEST/share/metainfo/org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
            ]
        },
        {
            "name": "SwiftLint",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/realm/SwiftLint/archive/refs/tags/0.59.1.zip",
                    "sha256": "a30fa111a01171cb8463136feea9b97015731bbdaaeacd941cdc88fbdca955e1"
                },
                "generated-sources-swiftlint.json"
            ],
            "build-commands": [
            	"./setup-offline-swiftlint.sh",
            	"/usr/lib/sdk/swift6/bin/swift build -c release --skip-update",
            	"strip -s .build/release/swiftlint",
                "cp .build/release/swiftlint /usr/lib/sdk/swift6/bin/"
            ]
        },
        {
            "name": "swift-format",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/swiftlang/swift-format.git",
                    "commit": "4c2421c14ce852fd455c257b4e8b9cae156302f1"
                },
                "generated-sources.json"
            ],
            "build-commands": [
                "./setup-offline.sh",
                "/usr/lib/sdk/swift6/bin/swift build -c release --skip-update",
                "strip -s .build/release/swift-format",
                "cp .build/release/swift-format /usr/lib/sdk/swift6/bin/"
            ]
        }
    ]
}
