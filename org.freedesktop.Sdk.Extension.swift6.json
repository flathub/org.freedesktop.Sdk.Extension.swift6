{
    "id": "org.freedesktop.Sdk.Extension.swift6",
    "branch": "24.08",
    "runtime": "org.freedesktop.Sdk",
    "build-extension": true,
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.llvm18"
    ],
    "runtime-version": "24.08",
    "separate-locales": false,
    "build-options": {
        "prefix": "/usr/lib/sdk/swift6",
        "prepend-pkg-config-path": "/usr/lib/sdk/swift5/lib/pkgconfig/"
    },
    "cleanup": [
        "/share/info",
        "/share/man"
    ],
    "modules": [
        {
            "name": "swift",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://download.swift.org/swift-6.1-release/amazonlinux2/swift-6.1-RELEASE/swift-6.1-RELEASE-amazonlinux2.tar.gz",
                    "sha256": "6c3350f5b202ded528cb2ab8b2e888e655f4d4b96f926692e19dfe92e5fca933"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://download.swift.org/swift-6.1-release/amazonlinux2-aarch64/swift-6.1-RELEASE/swift-6.1-RELEASE-amazonlinux2-aarch64.tar.gz",
                    "sha256": "0aaa0199d60c7bf59614297167ad295fc35b9afdcc6dcf6fb062a33c2bc2334f"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
                }
            ],
            "build-commands": [
                "mkdir -p /usr/lib/sdk/swift6",
                "cp -R usr/* /usr/lib/sdk/swift6",
                "install -Dm644 org.freedesktop.Sdk.Extension.swift6.metainfo.xml $FLATPAK_DEST/share/metainfo/org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
            ]
        },
        {
            "name": "SwiftLint",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/realm/SwiftLint/releases/download/0.59.0/swiftlint_linux.zip",
                    "sha256": "88a4df99705ae4b8db304501f55f648ecba9c9c12847865fd17df0e8a445d452"
                }
            ],
            "build-commands": [
                "cp swiftlint /usr/lib/sdk/swift6/bin/"
            ]
        },
        {
            "name": "swift-format",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/swiftlang/swift-format.git",
                    "commit": "ffbb3225ffda37b62c7283c70e87e8bc7e8e202a"
                },
                "generated-sources.json"
            ],
            "build-commands": [
                "./setup-offline.sh",
                "/usr/lib/sdk/swift6/bin/swift build -c release --skip-update",
                "strip -s .build/release/swift-format",
                "cp .build/release/swift-format /usr/lib/sdk/swift6/bin/"
            ]
        }
    ]
}
