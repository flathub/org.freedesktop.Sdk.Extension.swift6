{
    "id": "org.freedesktop.Sdk.Extension.swift6",
    "branch": "25.08",
    "runtime": "org.freedesktop.Sdk",
    "build-extension": true,
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.llvm21"
    ],
    "runtime-version": "25.08",
    "separate-locales": false,
    "build-options": {
        "prefix": "/usr/lib/sdk/swift6",
        "prepend-pkg-config-path": "/usr/lib/sdk/swift6/lib/pkgconfig/",
        "prepend-ld-library-path": "/usr/lib/sdk/swift6/lib",
        "ldflags": "-L/usr/lib/sdk/swift6/lib"
    },
    "cleanup": [
        "/share/info",
        "/share/man"
    ],
    "modules": [
        {
            "name": "libxml2",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.0.tar.xz",
                    "sha256": "5abc766497c5b1d6d99231f662e30c99402a90d03b06c67b62d6c1179dedd561"
                }
            ],
            "config-opts": [
                "--without-python",
                "--prefix=/usr/lib/sdk/swift6"
            ]
        },
        {
            "name": "swift",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://download.swift.org/swift-6.2.1-release/amazonlinux2/swift-6.2.1-RELEASE/swift-6.2.1-RELEASE-amazonlinux2.tar.gz",
                    "sha256": "218fc55ba7224626fd25f8ca285b083fda020e3737146e2fe10b8ae9aaf2ae97"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://download.swift.org/swift-6.2.1-release/amazonlinux2-aarch64/swift-6.2.1-RELEASE/swift-6.2.1-RELEASE-amazonlinux2-aarch64.tar.gz",
                    "sha256": "00999039a82a81b1e9f3915eb2c78b63552fe727bcbfe9a2611628ac350287f2"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
                }
            ],
            "build-commands": [
                "cp -R usr/* /usr/lib/sdk/swift6",
                "install -Dm644 org.freedesktop.Sdk.Extension.swift6.metainfo.xml $FLATPAK_DEST/share/metainfo/org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
            ]
        },
        {
            "name": "SwiftLint",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/realm/SwiftLint/archive/refs/tags/0.62.2.zip",
                    "sha256": "8009eacb55d7923a7bff89bd9730560a2691162bcecaa912c155bc3ea1120a24"
                },
                "generated-sources-swiftlint.json"
            ],
            "build-commands": [
                	"./setup-offline-swiftlint.sh",
                	"/usr/lib/sdk/swift6/bin/swift build -c release --skip-update",
                	"strip -s .build/release/swiftlint",
                "cp .build/release/swiftlint /usr/lib/sdk/swift6/bin/"
            ]
        },
        {
            "name": "swift-format",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/swiftlang/swift-format/archive/refs/tags/602.0.0.zip",
                    "sha256": "8009eacb55d7923a7bff89bd9730560a2691162bcecaa912c155bc3ea1120a24"
                },
                "generated-sources.json"
            ],
            "build-commands": [
                "./setup-offline.sh",
                "/usr/lib/sdk/swift6/bin/swift build -c release --skip-update",
                "strip -s .build/release/swift-format",
                "cp .build/release/swift-format /usr/lib/sdk/swift6/bin/"
            ]
        }
    ]
}
