{
    "id": "org.freedesktop.Sdk.Extension.swift6",
    "branch": "25.08",
    "runtime": "org.freedesktop.Sdk",
    "build-extension": true,
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.llvm21"
    ],
    "runtime-version": "25.08",
    "separate-locales": false,
    "build-options": {
        "prefix": "/usr/lib/sdk/swift6",
        "prepend-pkg-config-path": "/usr/lib/sdk/swift6/lib/pkgconfig/",
        "prepend-ld-library-path": "/usr/lib/sdk/swift6/lib",
        "ldflags": "-L/usr/lib/sdk/swift6/lib"
    },
    "cleanup": [
        "/share/info",
        "/share/man"
    ],
    "modules": [
        {
            "name": "libxml2",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libxml2/2.13/libxml2-2.13.9.tar.xz",
                    "sha256": "a2c9ae7b770da34860050c309f903221c67830c86e4a7e760692b803df95143a"
                }
            ],
            "config-opts": [
                "--without-python",
                "--prefix=/usr/lib/sdk/swift6"
            ]
        },
        {
            "name": "swift",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://download.swift.org/swift-6.2.3-release/amazonlinux2/swift-6.2.3-RELEASE/swift-6.2.3-RELEASE-amazonlinux2.tar.gz",
                    "sha256": "fe1513e441ab653a134f9fd35855fe5dddac5fa716c0b0fe119eb76757525f05"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://download.swift.org/swift-6.2.3-release/amazonlinux2-aarch64/swift-6.2.3-RELEASE/swift-6.2.3-RELEASE-amazonlinux2-aarch64.tar.gz",
                    "sha256": "0753ec4fb786c626a681803c25ea3c681df583f0f576a6e326a25bd92294b4c6"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
                }
            ],
            "build-commands": [
                "cp -R usr/* /usr/lib/sdk/swift6",
                "install -Dm644 org.freedesktop.Sdk.Extension.swift6.metainfo.xml $FLATPAK_DEST/share/metainfo/org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
            ]
        },
        {
            "name": "SwiftLint",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://github.com/realm/SwiftLint/releases/download/0.62.2/swiftlint_linux_amd64.zip",
                    "sha256": "d44e21c234cded72e1735abb32e8c641fadaf60270ef49ea6abf979a47a31deb"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://github.com/realm/SwiftLint/releases/download/0.62.2/swiftlint_linux_arm64.zip",
                    "sha256": "a90ea84be3675e787c5784e46dcb5d173a3bf0b35b4f4e9e455d7b8eb728947e"
                }
            ],
            "build-commands": [
                "cp swiftlint /usr/lib/sdk/swift6/bin/"
            ]
        },
        {
            "name": "swift-format",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/swiftlang/swift-format/archive/refs/tags/602.0.0.zip",
                    "sha256": "e0ce7eecc5e2c96e0efba9acb7e03eb592ddfe18b3f9fbe3260f3d55a4afb3ef"
                },
                "generated-sources.json"
            ],
            "build-commands": [
                "./setup-offline.sh",
                "/usr/lib/sdk/swift6/bin/swift build -c release --skip-update",
                "strip -s .build/release/swift-format",
                "cp .build/release/swift-format /usr/lib/sdk/swift6/bin/"
            ]
        }
    ]
}
