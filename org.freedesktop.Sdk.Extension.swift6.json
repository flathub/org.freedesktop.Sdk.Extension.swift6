{
    "id": "org.freedesktop.Sdk.Extension.swift6",
    "branch": "26.08",
    "runtime": "org.freedesktop.Sdk",
    "build-extension": true,
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "runtime-version": "26.08",
    "separate-locales": false,
    "build-options": {
        "prefix": "/usr/lib/sdk/swift6",
        "prepend-pkg-config-path": "/usr/lib/sdk/swift6/usr/lib/pkgconfig/",
        "prepend-ld-library-path": "/usr/lib/sdk/swift6/usr/lib",
        "ldflags": "-L/usr/lib/sdk/swift6/usr/lib"
    },
    "cleanup": [
        "/share/info",
        "/share/man"
    ],
    "modules": [
        {
            "name": "libxml2",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libxml2/2.13/libxml2-2.13.9.tar.xz",
                    "sha256": "a2c9ae7b770da34860050c309f903221c67830c86e4a7e760692b803df95143a"
                }
            ],
            "config-opts": [
                "--without-python",
                "--prefix=/usr/lib/sdk/swift6/usr"
            ]
        },
        {
            "name": "swift",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://download.swift.org/swift-6.4.0-release/fedora41/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE-fedora41.tar.gz",
                    "sha256": "15705cee4a7fc1709eb91a83e1e81c5f082391f7884f1d2dd3fa475824b74acb"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://download.swift.org/swift-6.4.0-release/fedora41-aarch64/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE-fedora41-aarch64.tar.gz",
                    "sha256": "ca1088186e3a3b278854b4f5b3d6975e5846d06748b1109ab259a959a5431f86"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
                }
            ],
            "build-commands": [
                "cp -R usr /usr/lib/sdk/swift6/",
                "install -Dm644 org.freedesktop.Sdk.Extension.swift6.metainfo.xml $FLATPAK_DEST/share/metainfo/org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
            ]
        },
        {
            "name": "SwiftLint",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://github.com/realm/SwiftLint/releases/download/0.65.1/swiftlint_linux_amd64.zip",
                    "sha256": "caeed6f4a679c35539ffaf124f6c4ab4a8416917f7d8796279dc52b74026059d"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://github.com/realm/SwiftLint/releases/download/0.65.1/swiftlint_linux_arm64.zip",
                    "sha256": "9ffa52f478e6d8eb485d37d14715ffac90abc81c58f3370d598bf75be05605f8"
                }
            ],
            "build-commands": [
                "cp swiftlint /usr/lib/sdk/swift6/usr/bin/"
            ]
        },
        {
            "name": "swift-format",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/swiftlang/swift-format/archive/refs/tags/604.0.0.zip",
                    "sha256": "6edb8941c0aa216e26bf7ff1d6ef54a76241e222597216e8b6d9f684bb9bca16"
                },
                "generated-sources.json"
            ],
            "build-commands": [
                "./setup-offline.sh",
                "/usr/lib/sdk/swift6/usr/bin/swift build -c release --skip-update",
                "strip -s .build/release/swift-format",
                "cp .build/release/swift-format /usr/lib/sdk/swift6/usr/bin/",
                "ln -s /usr/lib/sdk/swift6/usr/bin /usr/lib/sdk/swift6/bin",
                "ln -s /usr/lib/sdk/swift6/usr/lib /usr/lib/sdk/swift6/lib"
            ]
        }
    ]
}
