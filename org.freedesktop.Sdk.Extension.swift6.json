{
    "id": "org.freedesktop.Sdk.Extension.swift6",
    "branch": "25.08",
    "runtime": "org.freedesktop.Sdk",
    "build-extension": true,
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.llvm21"
    ],
    "runtime-version": "25.08",
    "separate-locales": false,
    "build-options": {
        "prefix": "/usr/lib/sdk/swift6",
        "prepend-pkg-config-path": "/usr/lib/sdk/swift6/lib/pkgconfig/",
        "prepend-ld-library-path": "/usr/lib/sdk/swift6/lib",
        "ldflags": "-L/usr/lib/sdk/swift6/lib"
    },
    "cleanup": [
        "/share/info",
        "/share/man"
    ],
    "modules": [
        {
            "name": "libxml2",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libxml2/2.13/libxml2-2.13.9.tar.xz",
                    "sha256": "a2c9ae7b770da34860050c309f903221c67830c86e4a7e760692b803df95143a"
                }
            ],
            "config-opts": [
                "--without-python",
                "--prefix=/usr/lib/sdk/swift6"
            ]
        },
        {
            "name": "swift",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://download.swift.org/swift-6.2.4-release/amazonlinux2/swift-6.2.4-RELEASE/swift-6.2.4-RELEASE-amazonlinux2.tar.gz",
                    "sha256": "969b1241a3fd9aa446cb47c1b2e4a7c72a54df9d48ec6f65aed09549095a71f5"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://download.swift.org/swift-6.2.4-release/amazonlinux2-aarch64/swift-6.2.4-RELEASE/swift-6.2.4-RELEASE-amazonlinux2-aarch64.tar.gz",
                    "sha256": "41fa73da20451831b29ddd989d0828f31f7b7e51633cf59249566f356e2b0ca1"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
                }
            ],
            "build-commands": [
                "cp -R usr/* /usr/lib/sdk/swift6",
                "install -Dm644 org.freedesktop.Sdk.Extension.swift6.metainfo.xml $FLATPAK_DEST/share/metainfo/org.freedesktop.Sdk.Extension.swift6.metainfo.xml"
            ]
        },
        {
            "name": "SwiftLint",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://github.com/realm/SwiftLint/releases/download/0.63.2/swiftlint_linux_amd64.zip",
                    "sha256": "dd1017cfd20a1457f264590bcb5875a6ee06cd75b9a9d4f77cd43a552499143b"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://github.com/realm/SwiftLint/releases/download/0.63.2/swiftlint_linux_arm64.zip",
                    "sha256": "104dedff762157f5cff7752f1cc2a289b60f3ea677e72d651c6f3a3287fdd948"
                }
            ],
            "build-commands": [
                "cp swiftlint /usr/lib/sdk/swift6/bin/"
            ]
        },
        {
            "name": "swift-format",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/swiftlang/swift-format/archive/refs/tags/602.0.0.zip",
                    "sha256": "e0ce7eecc5e2c96e0efba9acb7e03eb592ddfe18b3f9fbe3260f3d55a4afb3ef"
                },
                "generated-sources.json"
            ],
            "build-commands": [
                "./setup-offline.sh",
                "/usr/lib/sdk/swift6/bin/swift build -c release --skip-update",
                "strip -s .build/release/swift-format",
                "cp .build/release/swift-format /usr/lib/sdk/swift6/bin/"
            ]
        }
    ]
}
